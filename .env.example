# Local development settings. `npm run dev` copies this file to `.env` if `.env`
# does not exist yet; edit `.env`, not this file. These credentials are for local
# development only.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Keep ase3: backend/app/database/init.sql creates and seeds this database.
MYSQL_DATABASE=ase3
MYSQL_USER=ase
MYSQL_PASSWORD=ase
# Only used by Docker Compose when it first creates the MySQL volume.
MYSQL_ROOT_PASSWORD=root
