root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

# Trailing double spaces are a line break in Markdown.
[*.md]
trim_trailing_whitespace = false

[*.{js,mjs,vue,css,json,yml,yaml,html}]
indent_size = 2
